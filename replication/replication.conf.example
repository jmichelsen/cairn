# cairn vault pull config - copy to ~/.config/cairn/replication.conf and edit.
# Whitespace-separated; '#' starts a comment (on its own line only).

# How the vault reaches home (SSH). On the same LAN: user@home-lan-ip. Off-site: a VPN address
# or a public hostname. The pull uses the dedicated restricted key below, NOT your login key.
HOME_SSH  user@192.0.2.10
PORT      22                     # optional: home's SSH port, if not 22
KEY       /home/user/.ssh/cairn-pull

# One SET per replicated dataset:  SET <name> <source-on-home> <dest-on-vault> [raw]
# 'raw' does an encrypted raw send (-w) so the vault stores ciphertext it cannot read (zero-knowledge).
# Name each SET exactly like the vault's zfs-local target for that replica: the dashboard's
# "Replicate now" runs `vault-pull.sh --only <target name>`.
SET  photos     tank/photos     vault/photos
SET  documents  tank/documents  vault/documents  raw
