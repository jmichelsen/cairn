[Unit]
Description=backup-monitor Phase 0 check (snapshots, pool health/capacity, scrub age)
After=zfs.target network-online.target
Wants=zfs.target

[Service]
Type=oneshot
# Least-privilege: runs as jmichelsen. zpool/zfs/sanoid --monitor-snapshots are user-readable,
# and mail goes through a local SMTP relay (MAIL_MODE=relay) - no root needed.
# (Switch to User=root + MAIL_MODE=sendmail only if you don't want to use the relay.)
User=jmichelsen
Group=jmichelsen
Environment=BACKUP_MONITOR_ENV=/etc/backup-monitor/backup-monitor.env
ExecStart=/opt/backup-monitor/phase0/check_backups.sh
# Don't let a transient failure mark the unit failed forever; the timer retries.
SuccessExitStatus=0 1
Nice=10
IOSchedulingClass=idle
