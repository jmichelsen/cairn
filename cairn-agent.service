[Unit]
Description=cairn host agent (local, execute-capable)
Documentation=file://%h/cairn/AGENT.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Token (CAIRN_API_TOKEN) + SMTP/Gotify come from the config file via agent.py's load_env().
# The CAIRN_* below are set explicitly (setdefault in load_env won't override them).
Environment=PYTHONUNBUFFERED=1
Environment=CAIRN_ENV=%h/cairn/config/cairn.env
Environment=CAIRN_API_URL=http://localhost:8929
Environment=CAIRN_AGENT_NAME=local
Environment=CAIRN_TARGETS=%h/cairn/config/targets.yaml
Environment=CAIRN_CAN_EXECUTE=1
Environment=CAIRN_INTERVAL=120
# Safety valve: flip to 1 (and `systemctl --user restart`) to log actions instead of running them.
Environment=CAIRN_DRYRUN=0
WorkingDirectory=%h/cairn
# The user must be in the 'backup' group to read the root-owned borg repos. A `systemd --user`
# manager started BEFORE that membership won't carry the group, and a user unit can't add a group
# its manager lacks -- so wrap the agent in `sg backup`, which re-reads the group list at exec.
# (Harmless once the user manager is restarted/rebooted with the membership already in place.)
ExecStart=/usr/bin/sg backup -c "exec /usr/bin/python3 %h/cairn/agent.py"
Restart=on-failure
RestartSec=15
# Hardening: the agent needs ZFS/borg reads + zfs-delegated writes as this user; keep the rest tight.
NoNewPrivileges=false
ProtectSystem=false
PrivateTmp=false

[Install]
WantedBy=default.target
