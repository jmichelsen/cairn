# cairn config - copy to config/cairn.env and edit.
# Read by the API container (and the notifier it runs). An agent on the same host also loads it
# (CAIRN_ENV; values already in the agent's environment win). Agent-side vars (CAIRN_API_URL,
# CAIRN_TARGETS, CAIRN_CAN_EXECUTE, ...) usually live in the agent's systemd unit; see AGENT.md.

# This box's agent name: everything it reports is filed under it. install.sh writes the short
# hostname here on a fresh install; unset means "local". To change it later without losing
# history: ./install.sh --rename-agent NEW (a unit Environment= line, if any, wins over this).
CAIRN_AGENT_NAME=

# ============================ Email ============================
# MAIL_MODE=smtp  : generic SMTP (works for a local unauth relay OR an authed provider).
#                   MAIL_MODE=relay is an alias for smtp.
# MAIL_MODE=sendmail : use the host's /usr/sbin/sendmail (only when running on the host as root).
MAIL_MODE=smtp

# Recipient(s) and From. With MAIL_MODE=smtp the recipient must be a REAL address.
NOTIFY_EMAIL=you@example.com
MAIL_FROM=cairn@example.com

# --- SMTP server ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=on             # on = TLS/STARTTLS; off = plaintext (e.g. a trusted local relay)
SMTP_STARTTLS=on        # on = STARTTLS on a plain port (587); off = implicit TLS (465)
SMTP_USER=              # leave blank for an unauthenticated relay
SMTP_PASS=
# SMTP_AUTH=on          # default on when SMTP_USER is set

# Example: a local unauthenticated relay (e.g. an msmtpd sidecar) - no TLS, no auth:
#   MAIL_MODE=smtp
#   SMTP_HOST=msmtpd     (container name) or 127.0.0.1
#   SMTP_PORT=2500
#   SMTP_TLS=off
#   (leave SMTP_USER blank)

# ============================ Gotify (optional push for CRIT) ============================
GOTIFY_URL=                 # e.g. https://gotify.example.com  (blank = no push)
GOTIFY_TOKEN=               # a Gotify application token
NOTIFY_GOTIFY_WARN=0        # 1 = also push WARN (default: CRIT only)
GOTIFY_PRIORITY=8

# ============================ Auth (zero-trust - REQUIRED, no default) ============================
# EVERY request needs a token. Generate two: `openssl rand -hex 32` each, then fill all three below
# (the agent's token appears twice: as CAIRN_API_TOKEN that the local agent presents, and inside
# CAIRN_AGENT_TOKENS that the API accepts). Compose feeds this whole file to both containers.
#   CAIRN_ADMIN_TOKEN  - dashboard login + admin API (view + queue actions). Keep secret.
#   CAIRN_AGENT_TOKENS - comma-separated static agent token(s) the API accepts, for any agent
#                        (report-only or execute-capable). Per-agent tokens can also be minted.
#   CAIRN_API_TOKEN    - the token THIS local agent presents (must be one of CAIRN_AGENT_TOKENS).
# A leaked agent token can't read the dashboard or queue actions, but it is not bound to an agent
# name: it can report as, and claim the intents of, any agent (docs/architecture.md).
CAIRN_ADMIN_TOKEN=CHANGEME_admin_token
CAIRN_AGENT_TOKENS=CHANGEME_agent_token
CAIRN_API_TOKEN=CHANGEME_agent_token

# Instance name shown by GET /api/v1/identify (LAN discovery: mDNS + the Android client). Defaults
# to the hostname when unset.
CAIRN_NAME=

# ============================ Behavior ============================
NOTIFY_LOG=/data/cairn.log
STATE_DIR=/data/state
COOLDOWN_CRIT=21600         # re-alert throttle per finding (6h)
COOLDOWN_WARN=86400         # (24h)

# ---- Email routing + daily digest ----
# Per-severity EMAIL routing (push/Gotify is unaffected - urgent pushes always go out immediately):
#   immediate = email the moment it fires
#   digest    = hold it and include it in the once-daily summary email
#   off       = never email this severity (Gotify may still push it)
# Defaults below match the historic behavior (CRIT+WARN immediate, INFO off). To batch the daily WARN
# noise (aging drives, scrub cadence, 2nd-leg reminders) into one morning email, set EMAIL_WARN=digest.
EMAIL_CRIT=immediate
EMAIL_WARN=immediate
EMAIL_INFO=off              # INFO = one-shot confirmations ('2nd copy refreshed', action done)
# Hour (local, 0-23) the daily digest email goes out. Off by value 'off' (any digest-routed notices
# would then be held indefinitely). Harmless when nothing is routed to digest (empty spool = no mail).
CAIRN_DIGEST_HOUR=8

# ============================ API tuning (defaults shown) ============================
# CAIRN_SESSION_TTL=604800       # password-login session lifetime, seconds (7d)
# CAIRN_ACCESS_TTL=86400         # access token an enrolled agent gets, seconds (24h)
# CAIRN_ACK_TTL=1209600          # an acknowledgement lapses after this, seconds (14d)
# CAIRN_AGENT_STALE_FACTOR=3     # agent silent for N report intervals -> WARN
# CAIRN_AGENT_MISS_FACTOR=8      # agent silent for N report intervals -> CRIT
# CAIRN_AGENT_STALE_FLOOR=600    # minimum WARN threshold, seconds
# CAIRN_REMOVABLE_STALE_D=90     # removable copy older than this (days) stops counting for 3-2-1
# CAIRN_RECOVER_CACHE_TTL=600    # reuse a recovery listing this many seconds (0 = never reuse)
# CAIRN_RECOVER_WALK_INTERVAL=86400  # re-walk a dataset's deleted-files manifest after this, seconds
# CAIRN_CI_TOKEN=                # secret CI uses to POST /api/v1/ci/status (blank = route closed)
# CAIRN_PUBLIC_BADGES=tests      # comma-separated badge names served publicly at /badge/<name>.svg

# ============================ Agent ============================
# Seconds between agent report passes (agent-side; read by an agent that loads this file).
CAIRN_INTERVAL=900

# ============================ sanoid-derived freshness (ZFS) ============================
# Agent-side: read by the agent on the host that has sanoid.conf. When sanoid.conf is present, cairn
# derives each ZFS dataset's snapshot-freshness thresholds from the effective sanoid policy (finest active snapshot granularity -> that type's *_warn/*_crit), and
# SUPPRESSES the freshness verdict for datasets sanoid doesn't monitor (use_template=ignore /
# process_children_only). A per-target fresh_warn_h/fresh_crit_h in targets.yaml overrides this.
CAIRN_SANOID_DERIVE=1                        # 0 to disable and use the fixed defaults instead
# CAIRN_SANOID_CONF=/etc/sanoid/sanoid.conf
# CAIRN_SANOID_DEFAULTS=/etc/sanoid/sanoid.defaults.conf

# ============================ uptime-kuma (optional dead-man's switches) ============================
# cairn can be the thing that's broken (its OWN alert delivery died silently once on placeholder
# config). uptime-kuma is an independent watchdog with its own notification channels, so point these
# at Push monitors in your Kuma and it tells you when cairn can't.
#
# 1) Notify self-test heartbeat (recommended). The API periodically VERIFIES the alert delivery path
#    (recipient/SMTP host reachable + non-placeholder, Gotify reachable if configured) and pushes the
#    verdict here: status=up when alerts are deliverable, status=down the moment they aren't - so a
#    broken notify path surfaces itself instead of by accident. Create a Kuma "Push" monitor, set its
#    heartbeat interval a bit ABOVE CAIRN_KUMA_INTERVAL (e.g. monitor 180s, retries 2), add your
#    notification, and paste its push URL here.
CAIRN_KUMA_PUSH_URL=        # e.g. http://uptime-kuma:3001/api/push/<token>  (blank = disabled)
CAIRN_KUMA_INTERVAL=60      # seconds between self-tests (>=30)
#
# 2) Legacy phase0 heartbeat: only the standalone phase0/check_backups.sh uses this (not needed
#    with cairn). It pings at the end of every run.
KUMA_PUSH_BACKUP_CHECK=     # a uptime-kuma Push monitor URL

# ---- doctor (main box) ----
# Vault(s) phase1/doctor.py checks over ssh with your own key: user@host[:port], comma-separated.
# ./install.sh home --replication records this for you.
# e.g. CAIRN_VAULT_SSH=alice@vault.example:2222
CAIRN_VAULT_SSH=
