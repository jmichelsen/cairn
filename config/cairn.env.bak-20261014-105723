# backup-monitor config — copy to config/backup-monitor.env and edit.
# Consumed by the collector, API, notifier, and (host) action runner.

# ============================ Email ============================
# MAIL_MODE=smtp  : generic SMTP (works for a local unauth relay OR an authed provider).
# MAIL_MODE=sendmail : use the host's /usr/sbin/sendmail (only when running on the host as root).
MAIL_MODE=smtp

# Recipient(s) and From. With MAIL_MODE=smtp the recipient must be a REAL address.
NOTIFY_EMAIL=you@example.com
MAIL_FROM=backup-monitor@example.com

# --- SMTP server ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=on             # on = TLS/STARTTLS; off = plaintext (e.g. a trusted local relay)
SMTP_STARTTLS=on        # on = STARTTLS on a plain port (587); off = implicit TLS (465)
SMTP_USER=              # leave blank for an unauthenticated relay
SMTP_PASS=
# SMTP_AUTH=on          # default on when SMTP_USER is set

# Example: a local unauthenticated relay (e.g. an msmtpd sidecar) — no TLS, no auth:
#   MAIL_MODE=smtp
#   SMTP_HOST=msmtpd     (container name) or 127.0.0.1
#   SMTP_PORT=2500
#   SMTP_TLS=off
#   (leave SMTP_USER blank)

# ============================ Gotify (optional push for CRIT) ============================
GOTIFY_URL=                 # e.g. https://gotify.example.com  (blank = no push)
GOTIFY_TOKEN=               # a Gotify application token
NOTIFY_GOTIFY_WARN=0        # 1 = also push WARN (default: CRIT only)
GOTIFY_PRIORITY=8

# ============================ Auth (zero-trust — REQUIRED, no default) ============================
# EVERY request needs a token. Generate two: `openssl rand -hex 32` each, then fill all three below
# (the agent's token appears twice: as CAIRN_API_TOKEN that the local agent presents, and inside
# CAIRN_AGENT_TOKENS that the API accepts). Compose feeds this whole file to both containers.
#   CAIRN_ADMIN_TOKEN  - dashboard login + admin API (view + queue actions). Keep secret.
#   CAIRN_AGENT_TOKENS - comma-separated token(s) the API accepts from report-only agents.
#   CAIRN_API_TOKEN    - the token THIS local agent presents (must be one of CAIRN_AGENT_TOKENS).
# A leaked agent token can't read the dashboard or trigger actions (report/poll only).
CAIRN_ADMIN_TOKEN=ba101060ccf376d6804d4986e5733f9b139374b4e3f358f103888772aa4a7270
CAIRN_AGENT_TOKENS=c0c278f3b2169f51fe8ec8d9ae6e3592549d4364db514256c860dbacd790a24b
CAIRN_API_TOKEN=c0c278f3b2169f51fe8ec8d9ae6e3592549d4364db514256c860dbacd790a24b

# ============================ Behavior ============================
NOTIFY_LOG=/data/backup-monitor.log
STATE_DIR=/data/state
COOLDOWN_CRIT=21600         # re-alert throttle per finding (6h)
COOLDOWN_WARN=86400         # (24h)

# ---- Email routing + daily digest ----  (push/Gotify unaffected; urgent pushes stay immediate)
#   immediate = email now | digest = batch into the once-daily summary | off = never email
# Flip EMAIL_WARN=digest to collect the daily WARN noise into ONE morning email instead of drip-emails.
EMAIL_CRIT=immediate
EMAIL_WARN=immediate
EMAIL_INFO=off
CAIRN_DIGEST_HOUR=8         # local hour the daily digest goes out; 'off' disables the scheduler

# Collector loop (container 'collect' service)
CAIRN_INTERVAL=900             # seconds between passes
CAIRN_ALERT=1                  # 1 = collector sends WARN/CRIT alerts

# Actions (Phase 3). The API writes intent files here; the HOST runner executes them.
INTENT_DIR=/run/backup-intents

# ============================ uptime-kuma (optional dead-man's switch) ============================
KUMA_PUSH_BACKUP_CHECK=     # a uptime-kuma Push monitor URL, pinged on each clean run
